{
  "name": "social-network-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:production": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "prepare": "husky",
    "stylelint": "stylelint \"**/*.scss\"",
    "stylelint:fix": "stylelint \"**/*.scss\" --fix"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
